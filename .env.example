# Copy to .env and fill in real values. NEVER commit .env.

# --- Outbound: Google Sheets/Drive access (service account) ---
# base64 of the service account JSON key:  base64 -w0 service_account.json
CREDENTIALS_CONFIG=
# Optional: default Drive folder the tools operate in
DRIVE_FOLDER_ID=

# --- Inbound: MCP OAuth (claude.ai custom connector) ---
AUTH_ENABLED=true
# OAuth client (type: Web application) from GCP console; redirect URI must be
# ${AUTH_BASE_URL}/auth/callback
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Public HTTPS URL served by the Cloudflare Tunnel, e.g. https://sheets-mcp.example.com
AUTH_BASE_URL=
# Optional but recommended: stable signing key so tokens survive restarts.
# Generate with:  openssl rand -hex 32
AUTH_JWT_SIGNING_KEY=
# Comma-separated Google accounts allowed to use the connector (must match the
# OAuth consent screen Test users). Empty list = server refuses to start.
AUTH_ALLOWED_EMAILS=

# --- Tool whitelist (share_spreadsheet intentionally excluded) ---
ENABLED_TOOLS=list_sheets,get_sheet_data,get_sheet_formulas,update_cells,batch_update_cells,add_rows,list_spreadsheets

# --- Cloudflare Tunnel ---
TUNNEL_TOKEN=
